{
  "name": "spaceclean",
  "version": "3.0.1",
  "description": "Next-generation, ultra-fast storage cleaner and visual disk analyzer by Aneesh",
  "author": "Aneesh <aneeshgupta.work@gmail.com>",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "com.aneesh.spaceclean",
    "productName": "SpaceClean",
    "publish": [
      {
        "provider": "github",
        "owner": "AndyDev94",
        "repo": "SpaceClean"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "appx"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "appx": {
      "artifactName": "${productName}.${ext}",
      "applicationId": "SpaceClean",
      "identityName": "AneeshGupta.SpaceClean-DiskSpaceCleanerandAnalyzer",
      "publisher": "CN=D45DC341-5BA6-4D11-AA86-C14FBFD3E63F",
      "publisherDisplayName": "Aneesh Gupta",
      "displayName": "SpaceClean",
      "backgroundColor": "#0c1220"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpaceClean"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "${productName}.${ext}"
    },
    "dmg": {
      "title": "SpaceClean Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Aneesh <aneeshgupta.work@gmail.com>"
    },
    "appImage": {
      "artifactName": "${productName}.${ext}"
    },
    "deb": {
      "packageName": "spaceclean"
    }
  },
  "dependencies": {
    "chart.js": "^4.4.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
